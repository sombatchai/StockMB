CREATE TABLE IF NOT EXISTS employee (
    emp_id TEXT PRIMARY KEY, 
    emp_name TEXT, 
    age INTEGER, 
    sex TEXT, 
    phone TEXT, 
    position TEXT, 
    salary REAL, 
    qualification TEXT, 
    year_qual INTEGER, 
    email TEXT, 
    username TEXT, 
    password TEXT, 
    role TEXT DEFAULT 'Staff'
);

-- 2. เพิ่มข้อมูลผู้ดูแลระบบ (Admin) เข้าไปในตาราง
INSERT INTO employee (emp_id, emp_name, age, sex, phone, position, salary, qualification, year_qual, email, username, password, role) 
VALUES ('EMP001', 'ผู้ดูแลระบบ', 25, 'ชาย', '0812345678', 'Admin', 25000, 'ปริญญาตรี', 2024, 'admin@stockmb.com', 'admin', '1234', 'Admin');</sql><current_tab id="0"/></tab_sql></sqlb_project>
